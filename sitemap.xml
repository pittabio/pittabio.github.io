---
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    {% for page in site.pages %}
        {% if page.url contains '.html' and page.url != '/404.html' %}
            <url>
                <loc>{{ page.url | absolute_url | replace: 'index.html', '' }}</loc>
                <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
                <changefreq>weekly</changefreq>
                <priority>{% if page.url == '/' or page.url == '/index.html' %}1.0{% else %}0.8{% endif %}</priority>
            </url>
        {% endif %}
    {% endfor %}

    <!-- PDF -->
    <url>
        <loc>{{ '/media/games/ruins-rhapsody/code-map.pdf' | absolute_url }}</loc>
        <priority>0.6</priority>
    </url>
    <url>
        <loc>{{ '/media/games/zombie-siege/tech/TechDiagram.pdf' | absolute_url }}</loc>
        <priority>0.6</priority>
    </url>
</urlset>
